# rtpengine docker 化 (Alpine 版)
# 版本: mr13.5.1.27
FROM alpine:3.19

# 1. 启用 main 与 community 镜像源
RUN echo "http://dl-cdn.alpinelinux.org/alpine/v3.19/main" > /etc/apk/repositories && \
    echo "http://dl-cdn.alpinelinux.org/alpine/v3.19/community" >> /etc/apk/repositories

COPY ./rtpengine.mr13.5.1.27 /usr/local/src/rtpengine

# 2. 修复 CRLF 换行符（防止 Windows 克隆代码导致 /bin/bash\r 或 make 报错）
RUN apk add --no-cache sed && \
    find /usr/local/src/rtpengine -type f -exec sed -i 's/\r$//' {} \;

# 3. 安装编译依赖 -> 编译并安装 -> 清理构建工具与临时文件
RUN apk add --no-cache --virtual .build-deps \
        build-base git gperf linux-headers \
        glib-dev openssl-dev curl-dev \
        spandsp-dev ffmpeg-dev libevent-dev libpcap-dev \
        json-glib-dev mariadb-dev hiredis-dev libwebsockets-dev \
        libmnl-dev libnftnl-dev pcre2-dev iptables-dev \
        libjwt-dev bcg729-dev zlib-dev libnetfilter_conntrack-dev \
    && apk add --no-cache \
        glib openssl libcurl spandsp ffmpeg-libs \
        libevent libpcap json-glib mariadb-connector-c \
        hiredis libwebsockets libmnl libnftnl iptables \
        pcre2 libjwt bcg729 bash \
    && cd /usr/local/src/rtpengine/daemon \
    && make -j$(nproc) \
    && cp rtpengine /usr/local/bin/rtpengine \
    && cd / \
    && rm -rf /usr/local/src/rtpengine \
    && apk del .build-deps

CMD ["rtpengine", "-f"]
