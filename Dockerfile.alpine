# 阶段 1: 在 Alpine 环境中编译
FROM alpine:3.19 AS builder

# 开启 community 镜像源以获取 libjwt-dev 等扩展包
RUN echo "http://dl-cdn.alpinelinux.org/alpine/v3.19/main" > /etc/apk/repositories && \
    echo "http://dl-cdn.alpinelinux.org/alpine/v3.19/community" >> /etc/apk/repositories

# 安装 Alpine 正确匹配的开发依赖
RUN apk add --no-cache \
    build-base git glib-dev openssl-dev curl-dev \
    spandsp-dev ffmpeg-dev libevent-dev libpcap-dev \
    json-glib-dev mariadb-dev hiredis-dev libwebsockets-dev \
    libmnl-dev libnftnl-dev gperf pcre2-dev \
    iptables-dev libjwt-dev linux-headers bash

WORKDIR /usr/src/rtpengine
COPY . .

RUN cd daemon && make -j$(nproc)

# 阶段 2: 运行时环境
FROM alpine:3.19

RUN echo "http://dl-cdn.alpinelinux.org/alpine/v3.19/main" > /etc/apk/repositories && \
    echo "http://dl-cdn.alpinelinux.org/alpine/v3.19/community" >> /etc/apk/repositories

RUN apk add --no-cache \
    glib openssl libcurl spandsp ffmpeg-libs \
    libevent libpcap json-glib mariadb-connector-c \
    hiredis libwebsockets libmnl libnftnl iptables \
    pcre2 libjwt bash

COPY --from=builder /usr/src/rtpengine/daemon/rtpengine /usr/local/bin/rtpengine

EXPOSE 22222/udp 60000-65000/udp

CMD ["rtpengine", "--foreground"]
